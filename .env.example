# URL publique du frontend (utilisée pour les métadonnées et les aperçus sociaux)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.example

# URL de l'API backend
NEXT_PUBLIC_API_URL=https://api.votre-domaine.example/api/v1

# Optional: set to "false" to disable the public audience beacon entirely.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
